{
	"workspace": ["./packages/*", "./scripts/*", "./scripts/add/templates/*"],

	"tasks": {
		"gaps": {
			"description": "Find gaps in test coverage",
			"command": "deno test --no-prompt --coverage --allow-env --allow-read --allow-write --allow-run --parallel && deno coverage --detailed"
		},
		"ci": {
			"description": "Run CI checks",
			"command": "deno run --no-prompt --allow-env --allow-run --allow-write --allow-read @sekhmet/ci"
		},
		"add": {
			"description": "Add a workspace to the repository",
			"command": "deno run --no-prompt --allow-read --allow-write @sekhmet/add"
		}
	},

	"imports": {
		"@std/async": "jsr:@std/async@^1.0.15",
		"@std/cli": "jsr:@std/cli@1.0.24",
		"@std/fs": "jsr:@std/fs@1.0.20",
		"@std/path": "jsr:@std/path@1.1.3",
		"@std/assert": "jsr:@std/assert@1.0.16",
		"@std/testing": "jsr:@std/testing@1.0.16",
		"@std/fmt": "jsr:@std/fmt@1.0.8",

		"@biomejs/biome": "npm:@biomejs/biome@^2.3.10",

		"@~/": "./"
	},

	"fmt": {
		"useTabs": true
	},

	"compilerOptions": {
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"useUnknownInCatchVariables": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"isolatedDeclarations": true
	}
}
